# Database
DATABASE_URL=postgresql://logserver:logserver@db:5432/logserver

# AES Key/IV（Unity クライアントと一致させる）はプロジェクトごとに持つ。
# 変更は各プロジェクトの設定画面 <URL_PREFIX>/p/<slug>/settings（プロジェクト管理者・システム管理者）。
# 以下は初回起動（マイグレーション 007）で最初のプロジェクトを作るときに読まれる。
# 鍵が REPORT_AES_KEY / REPORT_AES_IV にも旧 system_config にも無いと起動時に失敗する（ランダム鍵で
# 無言のまま受信が壊れるのを防ぐため）。既存環境は旧 .env の値が残っていればそのまま使われる。
INITIAL_PROJECT_SLUG=default        # URL に使う識別子。小文字英数字とハイフン、2〜40 文字。予約語（admin, api 等）不可
INITIAL_PROJECT_NAME=Default        # 表示名
REPORT_AES_KEY=0123456789abcdef0123456789abcdef  # 最初のプロジェクトの AES Key（32 文字。16 / 24 も可だが UI は 32 を要求）
REPORT_AES_IV=abcdef0123456789                   # 同 IV（16 文字）

# Storage mode: "local" or "s3"
STORAGE_MODE=local
LOCAL_STORAGE_PATH=/app/storage

# AWS S3 (required when STORAGE_MODE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=ap-northeast-1
# S3 モードのスクリーンショット URL（署名付き）の有効期限（秒）。既定 1800 = 30 分。60〜604800。
# バケットは非公開にし、この URL でのみ画像を配信する（docs/aws_deploy_*.md の 3-2 を参照）。
S3_PRESIGN_EXPIRE_SECONDS=1800

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password
# ロックアウト復旧用（任意）。ADMIN_USERNAME のアカウントに紐付け、起動のたびに
# 管理者権限・有効状態を保証する Google アカウント。空なら無効。
ADMIN_GOOGLE_EMAIL=

# Session secret
SECRET_KEY=change-this-to-a-random-string

# URL prefix
# 全ルートの先頭に付くプレフィックス。先頭の "/" は省略可、末尾の "/" は無視される。
# 空にするとルート直下（/login 等）にマウントされる。
URL_PREFIX=/buglog

# Public URL
# 外部から到達できる公開 URL（末尾の "/" は不要）。Google ログインのリダイレクト URI と
# 招待リンクの組み立てに使う。nginx 経由では http と判定されてしまうため必ず明示する。
# 例: https://buglog.example.com  ローカル開発: http://127.0.0.1
PUBLIC_BASE_URL=

# Google ログイン（任意）
# GCP で OAuth 2.0 クライアント ID（ウェブアプリケーション）を作成し、承認済みのリダイレクト URI に
# <PUBLIC_BASE_URL><URL_PREFIX>/auth/google/callback を登録する。手順は docs/google_auth_setup.md。
# 未設定ならログイン画面に Google ボタンは表示されず、従来のパスワード認証のみになる。
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 招待リンクの有効期限（時間）
INVITE_EXPIRE_HOURS=72

# Claude Code 等から使う MCP サーバー（<URL_PREFIX>/mcp）を公開するか（true / false）。
# 読み取り専用 API（<URL_PREFIX>/api/reports）は常に有効。どちらも管理画面で発行する
# 個人 API トークン（Authorization: Bearer）が必要。手順は docs/claude_integration.md。
MCP_ENABLED=true

# 招待メールの送信方法: none（送信せず画面にリンクを表示するだけ） / ses / smtp
MAIL_MODE=none
# 送信元アドレス（ses / smtp で必須。SES では検証済みの ID であること）
MAIL_FROM=
# MAIL_MODE=ses: 認証情報は上記 AWS_* と AWS_REGION を使う（S3 と共通）
# MAIL_MODE=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# DB Memory Profile
# 軽量構成（RAM 0.5GB）は docker-compose.prod.yml の db.command で有効にする（内容は docker-compose.light.yml）。
# -f を明示して起動すると docker-compose.override.yml は自動で読み込まれないため、cp で置いても効かない。
# RAM 1GB 以上なら不要（PostgreSQL 既定値で動作）。
