# Database
DATABASE_URL=postgresql://logserver:logserver@db:5432/logserver

# AES Encryption (must match Unity client settings)
REPORT_AES_KEY=0123456789abcdef
REPORT_AES_IV=abcdef0123456789

# Storage mode: "local" or "s3"
STORAGE_MODE=local
LOCAL_STORAGE_PATH=/app/storage

# AWS S3 (required when STORAGE_MODE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_REGION=ap-northeast-1

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Session secret
SECRET_KEY=change-this-to-a-random-string

# URL prefix
# ※ 現状この値はアプリから読まれていない。プレフィックスは app/main.py /
#    app/routers/admin.py の _PREFIX = "/buglog" にハードコードされている。
URL_PREFIX=/buglog

# DB Memory Profile
# 軽量構成(t3.nano等)の場合: cp docker-compose.light.yml docker-compose.override.yml
# 標準構成(t3.micro以上)の場合: override不要（PostgreSQLデフォルト）
